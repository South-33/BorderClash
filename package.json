{
  "name": "borderclash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-public.mjs && next build --webpack",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "research": "node research/cli.mjs",
    "evidence:migration:snapshot": "node scripts/evidence-migration-harness.mjs snapshot",
    "evidence:migration:verify": "node scripts/evidence-migration-harness.mjs verify",
    "validate": "node research/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:automation": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/automation/run-cycle.test.ps1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.26",
    "lucide-react": "0.560.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x"
  }
}
